# ================================================================
# 배포용 환경변수 예시 — 실제 서버에서 이 파일을 .env.production 으로 복사해 값을 채운다.
#   cp .env.production.example .env.production   (그리고 아래 change-me 값 교체)
# 실행:
#   docker compose -f deploy/docker-compose.prod.yml --env-file .env.production up -d --build
# .env.production 은 git 에 커밋하지 않는다(.gitignore 의 *.env 규칙으로 제외됨).
# ================================================================

# ---- MariaDB (외부 미노출, 내부 네트워크 전용) ----
MARIADB_DATABASE=bootcamp
MARIADB_USER=bootcamp
MARIADB_PASSWORD=change-me-strong-db-password
MARIADB_ROOT_PASSWORD=change-me-strong-root-password

# ---- Backend (Spring Boot) ----
# JWT: 최소 32바이트 이상의 무작위 시크릿 (예: openssl rand -base64 48)
JWT_SECRET=change-me-please-use-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY_MINUTES=30
JWT_REFRESH_TOKEN_VALIDITY_DAYS=14

# 초기 관리자 계정
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NICKNAME=관리자

# 시연용 게스트 계정
GUEST_LOGIN_ID=guest
GUEST_PASSWORD=change-me-guest-password
GUEST_NICKNAME=게스트

# ---- 도메인 의존 값 (lib.solcho.com) ----
# nginx 가 프론트와 /api 를 같은 출처로 서빙하므로 CORS 는 사실상 트리거되지 않지만 명시.
CORS_ALLOWED_ORIGINS=http://lib.solcho.com

# refresh 쿠키: HTTP 동일 출처이므로 secure=false, SameSite=Lax, host-only(domain 비움).
# ⚠ HTTPS 로 전환하면 COOKIE_SECURE=true 로만 바꾸면 된다.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# ---- Frontend (빌드 시 주입) ----
# 브라우저가 호출할 API 베이스. 배포 도메인과 동일하게 둔다(nginx 가 /api 를 백엔드로 프록시).
VITE_API_BASE_URL=http://lib.solcho.com
