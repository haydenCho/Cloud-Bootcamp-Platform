# Backend 전용 환경 변수 (로컬 개발 시 사용). 실제 값은 backend/.env 에.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bootcamp
DB_USERNAME=bootcamp
DB_PASSWORD=change-me-db-password

# JWT: 최소 32바이트 이상의 무작위 시크릿
JWT_SECRET=change-me-please-use-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY_MINUTES=30
JWT_REFRESH_TOKEN_VALIDITY_DAYS=14

# 초기 관리자 계정 (코드 하드코딩 금지)
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NICKNAME=관리자

# 시연용 게스트 계정
GUEST_LOGIN_ID=guest
GUEST_PASSWORD=1234
GUEST_NICKNAME=게스트

# CORS 허용 오리진 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173
