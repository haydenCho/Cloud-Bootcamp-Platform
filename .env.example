# ================================================================
# 루트 통합 .env.example  (docker compose 에서 사용)
# 실제 값은 .env 에만 두고 git 에 커밋하지 않습니다.
# 개별 앱 전용 키는 frontend/.env.example, backend/.env.example 참고.
# ================================================================

# ---- MariaDB ----
MARIADB_DATABASE=bootcamp
MARIADB_USER=bootcamp
MARIADB_PASSWORD=change-me-db-password
MARIADB_ROOT_PASSWORD=change-me-root-password

# ---- Backend (Spring Boot) ----
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=bootcamp
DB_USERNAME=bootcamp
DB_PASSWORD=change-me-db-password

# JWT: 최소 32바이트 이상의 무작위 시크릿 (Base64 권장)
JWT_SECRET=change-me-please-use-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_VALIDITY_MINUTES=30
JWT_REFRESH_TOKEN_VALIDITY_DAYS=14

# 초기 관리자 계정 (코드에 하드코딩 금지)
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NICKNAME=관리자

# 시연용 게스트 계정
GUEST_LOGIN_ID=guest
GUEST_PASSWORD=1234
GUEST_NICKNAME=게스트

# CORS 로 허용할 프론트엔드 주소 (배포: http://lib.solcho.com)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# refresh 토큰 쿠키 (도메인/프로토콜 의존). 로컬·HTTP 동일출처 기본값.
# HTTPS 전환 시 COOKIE_SECURE=true 로 변경. COOKIE_DOMAIN 은 비워두면 host-only(권장).
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# ---- Frontend ----
# 빌드 시점에 주입되는 API 베이스 URL (배포: http://lib.solcho.com — nginx 가 /api 를 백엔드로 프록시)
VITE_API_BASE_URL=http://localhost:8080
